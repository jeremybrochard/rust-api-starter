#!/bin/sh
# Pre-commit hook: format and lint staged Rust files

set -e

echo "Running pre-commit checks..."

# Get staged Rust files
STAGED_FILES=$(git diff --cached --name-only --diff-filter=ACM | grep '\.rs$' || true)

if [ -z "$STAGED_FILES" ]; then
    echo "No Rust files staged, skipping checks."
    exit 0
fi

# Check formatting
echo "Checking formatting with cargo fmt..."
if ! cargo fmt --check; then
    echo ""
    echo "ERROR: Code is not formatted correctly."
    echo "Please run 'cargo fmt' to fix formatting issues."
    exit 1
fi

# Run clippy
echo "Running clippy..."
if ! cargo clippy -- -D warnings; then
    echo ""
    echo "ERROR: Clippy found issues."
    echo "Please fix the warnings above."
    exit 1
fi

echo "Pre-commit checks passed!"
exit 0
