#!/bin/sh
# Pre-commit hook: format and lint staged Rust files

set -e

echo "Running pre-commit checks..."

# Get staged Rust files
STAGED_FILES=$(git diff --cached --name-only --diff-filter=ACM | grep '\.rs$' || true)

if [ -z "$STAGED_FILES" ]; then
    echo "No Rust files staged, skipping checks."
    exit 0
fi

# Auto-fix formatting
echo "Formatting code with cargo fmt..."
cargo fmt

# Re-stage formatted files
echo "Re-staging formatted files..."
for file in $STAGED_FILES; do
    if [ -f "$file" ]; then
        git add "$file"
    fi
done

# Run clippy
echo "Running clippy..."
if ! cargo clippy -- -D warnings; then
    echo ""
    echo "ERROR: Clippy found issues."
    echo "Please fix the warnings above."
    exit 1
fi

echo "Pre-commit checks passed!"
exit 0
