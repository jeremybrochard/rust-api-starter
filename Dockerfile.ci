# CI/CD Dockerfile with SonarQube and DependencyTrack analysis
# Usage:
#   docker build -f Dockerfile.ci -t rust-api-starter:ci \
#     --build-arg RUN_SONAR=true \
#     --build-arg RUN_DTRACK=true \
#     .

FROM rust:1.83-slim as builder

WORKDIR /app

# Build arguments for analysis steps
ARG RUN_SONAR=false
ARG RUN_DTRACK=false

# Environment variables for SonarQube
ARG SONAR_HOST_URL
ARG SONAR_TOKEN
ARG SONAR_PROJECT_KEY=rust-api-starter

# Environment variables for DependencyTrack
ARG DTRACK_URL
ARG DTRACK_API_KEY
ARG DTRACK_PROJECT_NAME
ARG DTRACK_PROJECT_VERSION

# Environment variables for DependencyTrack badges (GitLab)
ARG DTRACK_BADGE_API_KEY
ARG GITLAB_URL
ARG GITLAB_PROJECT_ID
ARG GITLAB_TOKEN

# Install build and analysis dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    pkg-config \
    curl \
    python3 \
    && rm -rf /var/lib/apt/lists/*

# Copy manifests
COPY Cargo.toml Cargo.lock ./

# Create dummy source to cache dependencies
RUN mkdir src && \
    echo "fn main() {}" > src/main.rs && \
    echo "pub fn dummy() {}" > src/lib.rs

# Build dependencies only
RUN cargo build --release && \
    rm -rf src

# Copy actual source code
COPY src ./src
COPY scripts ./scripts
COPY sonar-project.properties ./

# Make scripts executable
RUN chmod +x scripts/*.sh

# Touch main.rs to invalidate cache for our code only
RUN touch src/main.rs src/lib.rs

# Run tests
RUN cargo test --release

# Run Clippy
RUN cargo clippy --release -- -D warnings

# Build final binary
RUN cargo build --release

# === SBOM Generation (DependencyTrack) ===
RUN if [ "$RUN_DTRACK" = "true" ]; then \
        echo "=== Installing cargo-cyclonedx ===" && \
        cargo install cargo-cyclonedx && \
        echo "=== Generating SBOM ===" && \
        cargo cyclonedx --format json --output-path sbom.json && \
        if [ -n "$DTRACK_URL" ] && [ -n "$DTRACK_API_KEY" ] && [ -n "$DTRACK_PROJECT_NAME" ]; then \
            echo "=== Uploading SBOM to DependencyTrack ===" && \
            ./scripts/dtrack-upload.sh && \
            if [ -n "$DTRACK_BADGE_API_KEY" ] && [ -n "$GITLAB_URL" ] && [ -n "$GITLAB_PROJECT_ID" ] && [ -n "$GITLAB_TOKEN" ]; then \
                echo "=== Updating GitLab badges ===" && \
                ./scripts/dtrack-badges.sh; \
            fi; \
        else \
            echo "=== SBOM generated but DependencyTrack credentials not provided ==="; \
        fi \
    fi

# === SonarQube Analysis ===
RUN if [ "$RUN_SONAR" = "true" ]; then \
        echo "=== Running SonarQube Analysis ===" && \
        if [ -n "$SONAR_HOST_URL" ] && [ -n "$SONAR_TOKEN" ]; then \
            export SONAR_HOST_URL="$SONAR_HOST_URL" && \
            export SONAR_TOKEN="$SONAR_TOKEN" && \
            export SONAR_PROJECT_KEY="$SONAR_PROJECT_KEY" && \
            ./scripts/sonar-scan.sh; \
        else \
            echo "=== SonarQube credentials not provided, skipping upload ==="; \
            cargo clippy --message-format=json > clippy-output.json 2>&1 || true; \
        fi \
    fi

# Runtime stage
FROM debian:bookworm-slim as runtime

WORKDIR /app

# Install runtime dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates \
    && rm -rf /var/lib/apt/lists/*

# Create non-root user
RUN useradd -r -s /bin/false appuser

# Copy binary from builder
COPY --from=builder /app/target/release/rust-api-starter /app/rust-api-starter

# Copy SBOM if generated (for artifact extraction)
COPY --from=builder /app/sbom.json /app/sbom.json 2>/dev/null || true

# Set ownership
RUN chown appuser:appuser /app/rust-api-starter

USER appuser

# Expose port
EXPOSE 3000

# Set environment variables
ENV HOST=0.0.0.0
ENV PORT=3000
ENV RUST_LOG=info

# Run the binary
CMD ["./rust-api-starter"]
